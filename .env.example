# Self-hosted inference is the default. No fal account or credits are needed.
VIDEO_PROVIDER=local
SELF_HOSTED_URL=http://127.0.0.1:8188
# Shared secret you generate yourself, used only between Toon and your GPU worker.
SELF_HOSTED_TOKEN=
# Optional alternative, enabled only when VIDEO_PROVIDER=fal.
# Never put this key in web/ or commit your .env file.
FAL_KEY=
# Local development is loopback-only by default.
HOST=127.0.0.1
PORT=3000
PUBLIC_ORIGIN=http://localhost:3000
# Required (16+ characters) if HOST is not loopback.
STUDIO_PASSWORD=
DATA_DIR=./data
# Optional local script-writing model. Leave blank for manual scene splitting.
OLLAMA_URL=
OLLAMA_MODEL=
# Generation is serial and capped at eight scenes per render.
POLL_INTERVAL_MS=5000
PROVIDER_TIMEOUT_MS=7200000
